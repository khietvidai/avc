---
import { getMenu, getSiteSettings, getEmDashEntry } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { toEnUrl, toViUrl } from "../utils/i18n-routes";
import { logoImageSeo } from "../utils/image-seo";
import { publicOrigin } from "../utils/site-url";
import {
	absolutize,
	buildSeoGraph,
	canonicalUrl,
	defaultDescription,
	hreflangLinks,
	orgFromEntry,
	type ProjectSchemaInput,
	type SeoLocale,
} from "../utils/seo";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Project JSON-LD (English / Vietnamese project detail) */
	project?: ProjectSchemaInput | null;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
	project,
} = Astro.props;
const { siteTitle: siteTitleVI, siteLogo } = resolveBlogSiteIdentity(await getSiteSettings());
let orgEntry = null;
try {
	const orgQuery = await getEmDashEntry("organization", "avc");
	orgEntry = orgQuery.entry;
} catch {
	orgEntry = null;
}
const org = orgFromEntry(orgEntry);
const locale = (Astro.currentLocale ?? "en") as SeoLocale;
const isEN = locale === "en";
const siteTitle = isEN ? org.nameEn : siteTitleVI || org.nameVi;
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const origin = publicOrigin(Astro.url);
const pageCanonical = canonical
	? (absolutize(origin, canonical) as string)
	: canonicalUrl(origin, Astro.url.pathname);
const metaDescription = description || defaultDescription(locale, org);
const ogImage = absolutize(origin, image) || absolutize(origin, siteLogo?.url);
const altLinks = hreflangLinks(origin, Astro.url.pathname);
const seoGraphJson = JSON.stringify(
	buildSeoGraph({
	origin,
	pathname: Astro.url.pathname,
	locale,
	title: fullTitle,
	description: metaDescription,
	canonical: pageCanonical,
	image: ogImage,
	logo: absolutize(origin, siteLogo?.url),
	org,
	project: project
		? {
				...project,
				url: project.url || pageCanonical,
				image: absolutize(origin, project.image) || ogImage,
			}
		: null,
	}),
).replace(/</g, "\\u003c");

// Fetch primary menu defined in seed
const menu = await getMenu("primary", { locale: "vi" });

// Optional "social" menu rendered as icon squares in the footer
const socialMenu = await getMenu("social", { locale: "vi" });

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: metaDescription,
	canonical: pageCanonical,
	image: ogImage,
	content,
	seo: { ogImage, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: "AVC",
	siteUrl: origin,
	breadcrumbs: [],
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;

// --- Song ngữ: locale hiện tại + dịch label menu + URL prefix ---

const NAV_EN: Record<string, string> = {
	"Trang chủ": "Home",
	"Giới thiệu": "About",
	"Dịch vụ": "Services",
	"Sản phẩm": "Products",
	Portfolio: "Portfolio",
	"Liên hệ": "Contact",
	"Về AVC": "About AVC",
	"Giá trị cốt lõi": "Core Values",
	"Đội ngũ & Văn hoá": "Team & Culture",
	"Tư vấn đầu tư": "Consulting",
	"Thiết kế bếp": "Kitchen Design",
	"Cung cấp thiết bị": "Equipment Supply",
	"Thi công lắp đặt": "Installation",
	"Bảo hành – Bảo trì": "Warranty & Maintenance",
	"Sản xuất inox": "Stainless Fabrication",
	"Nhà hàng": "Restaurants",
	"Khách sạn": "Hotels",
	"Bếp trung tâm": "Central Kitchens",
	"Khu công nghiệp": "Industrial Canteens",
	Bakery: "Bakeries",
	"Bar & Café": "Bar & Café",
};
const t = (label: string) => (isEN ? (NAV_EN[label] ?? label) : label);
const localizeUrl = (url: string) => (isEN ? toEnUrl(url) : toViUrl(url));

const path = Astro.url.pathname;
const viUrl = toViUrl(path);
const enUrl = toEnUrl(path);

// Server-side active state for nav links. Anchor links ("/#gioi-thieu")
// can't be matched against the pathname, so they're never marked active.
const currentPath = (isEN ? toEnUrl(path) : path.replace(/^\/vi(?=\/|$)/, "") || "/").replace(/\/{2,}/g, "/") || "/";
function isActive(url: string): boolean {
	if (url.includes("#")) return false;
	const target = isEN ? toEnUrl(url) : url;
	if (target === "/") return currentPath === "/";
	return currentPath === target || currentPath.startsWith(`${target}/`);
}

const year = new Date().getFullYear();

// Compact initials for the LinkedIn-style social squares ("in" for LinkedIn)
function socialInitials(label: string): string {
	return label.toLowerCase() === "linkedin" ? "in" : label.charAt(0);
}
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico?v=avc" sizes="32x32" />
		<link rel="icon" href="/favicon.png?v=avc" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=avc" />
		<Font cssVariable="--font-body" preload />
		<title>{fullTitle}</title>
		<meta name="theme-color" content="#5f6a12" />
		<link rel="canonical" href={pageCanonical} />
		<link rel="alternate" hreflang="en" href={altLinks.en} />
		<link rel="alternate" hreflang="vi" href={altLinks.vi} />
		<link rel="alternate" hreflang="x-default" href={altLinks.xDefault} />
		<meta property="og:locale" content={isEN ? "en_US" : "vi_VN"} />
		<meta property="og:locale:alternate" content={isEN ? "vi_VN" : "en_US"} />
		<link rel="alternate" type="application/rss+xml" title={siteTitle} href={`${origin}/rss.xml`} />
		<EmDashHead page={pageCtx} />
		<script type="application/ld+json" set:html={seoGraphJson} />
		<slot name="head" />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">{isEN ? "Skip to content" : "Tới nội dung"}</a>
		<header class="site-header">
			<div class="header-inner">
				<a href={localizeUrl("/")} class="site-logo">
					{siteLogo
						? <img src={siteLogo.url} alt={logoImageSeo().alt} title={logoImageSeo().title} class="site-logo-img" width="96" height="34" decoding="async" />
						: <span class="site-logo-text">{siteTitle}</span>
					}
				</a>
				<nav class="site-nav" aria-label={isEN ? "Primary navigation" : "Điều hướng chính"}>
					{
						menu?.items.map((item) => (
							<div class="nav-item">
								<a
									href={localizeUrl(item.url)}
									target={item.target}
									class:list={["site-nav-link", { active: isActive(item.url) }]}
									aria-haspopup={item.children?.length ? "true" : undefined}
								>
									{t(item.label)}
								</a>
								{item.children?.length > 0 && (
									<div class="nav-dropdown">
										{item.children.map((child) => (
											<a
												href={localizeUrl(child.url)}
												target={child.target}
												class="nav-dropdown-link"
											>
												{t(child.label)}
											</a>
										))}
									</div>
								)}
							</div>
						))
					}
				</nav>
				<div class="nav-side">
					<div class="lang-switcher" role="navigation" aria-label={isEN ? "Language" : "Ngôn ngữ"}>
						<a href={viUrl} class:list={[{ active: !isEN }]} hreflang="vi" lang="vi" aria-current={!isEN ? "page" : undefined}>VI</a>
						<span aria-hidden="true">|</span>
						<a href={enUrl} class:list={[{ active: isEN }]} hreflang="en" lang="en" aria-current={isEN ? "page" : undefined}>EN</a>
					</div>
					{
						isLoggedIn && (
							<a href="/_emdash/admin" class="nav-admin">
								Admin
							</a>
						)
					}
				</div>
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer" id={isEN ? "contact" : "lien-he"}>
			<nav class="footer-nav" aria-label={isEN ? "Footer navigation" : "Điều hướng chân trang"}>
				{
					menu?.items.map((item) => (
						<a
							href={localizeUrl(item.url)}
							target={item.target}
							class:list={["footer-nav-link", { active: isActive(item.url) }]}
						>
							{t(item.label)}
						</a>
					))
				}
			</nav>
			{
				socialMenu && socialMenu.items.length > 0 && (
					<div class="footer-social">
						{socialMenu.items.map((item) => (
							<a
								href={item.url}
								target="_blank"
								rel="noopener noreferrer"
								class="footer-social-link"
								aria-label={item.label}
							>
								{socialInitials(item.label)}
							</a>
						))}
					</div>
				)
			}
			<div class="footer-contact">
				<div class="footer-address">
					{
						isEN ? (
							<p>
								Showroom: 58 Nguyen Hoang, Binh Trung Ward, Ho Chi Minh City
								{" · "}
								Warehouse: 12/64 Thanh Loc 27 St., Quarter 3C, District 12, Ho Chi Minh City
							</p>
						) : (
							<WidgetArea name="footer" />
						)
					}
				</div>
				<div>
					Hotline <a href="tel:19000054" class="footer-hotline">1900 0054</a>
					&nbsp;·&nbsp;
					<a href="mailto:info@avc.equipment" class="footer-mail">info@avc.equipment</a>
					&nbsp;·&nbsp; thietbibepauviet.com | avc.equipment
				</div>
				<div class="footer-copyright">© {year} {siteTitle}</div>
			</div>
		</footer>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}
			}
		</style>

		<style>
			.skip-link {
				position: absolute;
				left: 12px;
				top: -64px;
				z-index: 9999;
				padding: 8px 14px;
				background: var(--color-brand);
				color: var(--color-on-brand);
				font-size: 13px;
				font-weight: 600;
				letter-spacing: 0.04em;
			}

			.skip-link:focus {
				top: 12px;
				color: var(--color-on-brand);
			}

			#main:focus {
				outline: none;
			}

			.site-header {
				background: var(--color-bg);
			}

			.header-inner {
				max-width: 1460px;
				margin: 0 auto;
				padding: 18px 40px;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: clamp(32px, 7vw, 110px);
				position: relative;
			}

			.site-logo {
				display: flex;
				align-items: center;
				text-decoration: none;
			}

			.site-logo-img {
				width: 96px;
				height: 34px;
				object-fit: contain;
			}

			.site-logo-text {
				font-size: 17px;
				font-weight: 700;
				letter-spacing: 2px;
				text-transform: uppercase;
				color: var(--color-brand);
				white-space: nowrap;
			}

			.site-nav {
				display: flex;
				align-items: center;
				font-family: var(--font-heading);
				font-size: 12.5px;
				font-weight: 600;
				letter-spacing: 1.8px;
				text-transform: uppercase;
			}

			.nav-item {
				position: relative;
				display: flex;
				align-items: center;
			}

			.nav-item + .nav-item::before {
				content: "";
				width: 1px;
				height: 22px;
				background: var(--avc-nav-separator);
			}

			.site-nav-link {
				display: block;
				padding: 6px 28px;
				color: var(--avc-nav-text);
				white-space: nowrap;
			}

			.site-nav-link:hover,
			.site-nav-link.active {
				color: var(--color-brand);
			}

			/* Dropdown submenu */
			.nav-dropdown {
				position: absolute;
				top: 100%;
				left: 50%;
				transform: translateX(-50%);
				min-width: 240px;
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
				display: none;
				z-index: 200;
			}

			.nav-item:hover .nav-dropdown,
			.nav-item:focus-within .nav-dropdown {
				display: block;
			}

			/* giữ vùng hover liền mạch giữa link và dropdown */
			.nav-dropdown::before {
				content: "";
				position: absolute;
				top: -8px;
				left: 0;
				right: 0;
				height: 8px;
			}

			.nav-dropdown-link {
				display: block;
				padding: 12px 22px;
				text-align: center;
				font-size: 11.5px;
				font-weight: 600;
				letter-spacing: 1.5px;
				text-transform: uppercase;
				color: var(--avc-nav-text);
				white-space: nowrap;
			}

			.nav-dropdown-link + .nav-dropdown-link {
				border-top: 1px solid var(--avc-nav-separator);
			}

			.nav-dropdown-link:hover {
				color: var(--color-brand);
			}

			.nav-side {
				position: absolute;
				right: var(--spacing-4);
				top: 50%;
				transform: translateY(-50%);
				display: flex;
				align-items: center;
				gap: var(--spacing-4);
			}

			.lang-switcher {
				display: flex;
				align-items: center;
				gap: 7px;
				font-size: 11.5px;
				font-weight: 600;
				letter-spacing: 1.5px;
			}

			.lang-switcher span {
				color: var(--avc-nav-separator);
			}

			.lang-switcher a {
				color: var(--avc-nav-text);
			}

			.lang-switcher a.active {
				color: var(--color-brand);
			}

			.nav-admin {
				font-size: var(--font-size-xs);
				color: var(--color-text-secondary);
			}

			.nav-admin:hover {
				color: var(--color-text);
			}

			main {
				min-height: calc(100vh - 300px);
			}

			/* Footer */
			.site-footer {
				border-top: 1px solid var(--color-border);
			}

			.footer-nav {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 34px 24px 10px;
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				font-family: var(--font-heading);
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 1.5px;
				text-transform: uppercase;
			}

			.footer-nav-link {
				padding: 4px 18px;
				color: var(--avc-nav-text);
				white-space: nowrap;
			}

			.footer-nav-link + .footer-nav-link {
				border-left: 1px solid var(--avc-nav-separator);
			}

			.footer-nav-link:hover,
			.footer-nav-link.active {
				color: var(--color-brand);
			}

			.footer-social {
				display: flex;
				justify-content: center;
				gap: var(--spacing-3);
				padding: 18px 0 8px;
			}

			.footer-social-link {
				width: 40px;
				height: 40px;
				background: var(--avc-linkedin);
				color: #ffffff;
				display: flex;
				align-items: center;
				justify-content: center;
				font-weight: 700;
				font-size: 19px;
				font-family: Arial, sans-serif;
				border-radius: 3px;
			}

			.footer-social-link:hover {
				background: #0857a6;
				color: #ffffff;
			}

			.footer-contact {
				text-align: center;
				padding: 10px 24px 30px;
				font-size: 12.5px;
				line-height: 1.8;
				color: var(--avc-footer-text);
			}

			.footer-address,
			.footer-address :global(.widget__content),
			.footer-address :global(.widget__content p) {
				font-size: 12.5px;
				line-height: 1.8;
				color: var(--avc-footer-text);
			}

			.footer-address :global(.widget__title) {
				display: none;
			}

			.footer-hotline {
				color: var(--color-brand);
				font-weight: 700;
			}

			.footer-mail {
				color: var(--avc-footer-text);
			}

			.footer-mail:hover {
				color: var(--color-brand);
			}

			.footer-copyright {
				margin-top: 6px;
			}

			@media (max-width: 900px) {
				.header-inner {
					flex-direction: column;
					gap: var(--spacing-3);
					padding: 16px 16px;
				}

				.site-nav {
					flex-wrap: wrap;
					justify-content: center;
				}

				.site-nav-link {
					padding: 6px 14px;
				}

				.nav-side {
					top: var(--spacing-3);
					transform: none;
				}
			}

			@media (max-width: 640px) {
				.site-logo-text {
					white-space: normal;
					text-align: center;
					font-size: 16px;
				}

				/* mobile: ẩn dropdown, link cha vẫn điều hướng được */
				.nav-dropdown {
					display: none !important;
				}

				.site-nav {
					font-size: 13px;
				}

				.site-nav-link {
					padding: 4px 10px;
				}

				.footer-nav-link {
					padding: 4px 10px;
				}
			}
		</style>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
