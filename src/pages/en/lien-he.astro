---
import Base from "../../layouts/Base.astro";
---

<Base title="Contact" description="Contact AVC Industrial Equipment Co., Ltd — Hotline 1900 0054, showroom at 58 Nguyen Hoang, Binh Trung Ward, Ho Chi Minh City">
	<div class="page">
		<section class="section">
			<h1 class="page-title">CONTACT AVC</h1>
			<hr class="dashed-divider" />
			<p class="lead">The AVC team is ready to advise on the right commercial kitchen solution for your project — from site survey and design to equipment quotation.</p>

			<div class="contact-grid">
				<div class="contact-card">
					<h3>Showroom</h3>
					<p>58 Nguyen Hoang, Binh Trung Ward,<br />Ho Chi Minh City, Vietnam</p>
				</div>
				<div class="contact-card">
					<h3>Warehouse</h3>
					<p>12/64 Thanh Loc 27 St., Quarter 3C, District 12,<br />Ho Chi Minh City, Vietnam</p>
				</div>
				<div class="contact-card highlight">
					<h3>Hotline</h3>
					<p class="hotline"><a href="tel:19000054">1900 0054</a></p>
					<p class="sub">Support &amp; maintenance 24/7</p>
				</div>
				<div class="contact-card">
					<h3>Email &amp; Website</h3>
					<p><a href="mailto:info@avc.equipment">info@avc.equipment</a></p>
					<p class="sub">thietbibepauviet.com | avc.equipment</p>
				</div>
			</div>
		</section>

		<section class="section steps-section">
			<h2 class="section-title">HOW WE WORK</h2>
			<hr class="dashed-divider" />
			<div class="steps">
				<div class="step"><span>1</span><h4>Enquiry</h4><p>Call our hotline or email a brief of your project.</p></div>
				<div class="step"><span>2</span><h4>Survey &amp; consult</h4><p>AVC surveys the site and advises on capacity and standards.</p></div>
				<div class="step"><span>3</span><h4>Design &amp; quote</h4><p>2D/3D layout, MEP coordination and a detailed quotation.</p></div>
				<div class="step"><span>4</span><h4>Build &amp; handover</h4><p>Fabrication, installation, commissioning — then warranty &amp; maintenance.</p></div>
			</div>
		</section>

		<section class="section cta-section">
			<a href="tel:19000054" class="btn">Call 1900 0054</a>
			<a href="mailto:info@avc.equipment" class="btn btn-outline">Send an email</a>
		</section>
	</div>
</Base>

<style>
	.page {
		max-width: 1000px;
		margin: 0 auto;
		padding: 44px 24px 80px;
	}

	.section {
		margin-bottom: 64px;
		text-align: center;
	}

	.page-title {
		font-size: 26px;
		font-weight: 700;
		letter-spacing: 2.5px;
		color: var(--color-brand);
	}

	.section-title {
		font-size: 21px;
		font-weight: 700;
		letter-spacing: 2.5px;
		color: var(--color-brand);
	}

	.dashed-divider {
		width: 210px;
		margin: 16px auto 34px;
		border: none;
		border-bottom: 2px dashed var(--avc-divider);
	}

	.lead {
		max-width: 640px;
		margin: 0 auto 40px;
		font-size: 15px;
		line-height: 1.65;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
		text-align: left;
	}

	.contact-card {
		padding: 28px;
		border: 1px solid var(--color-border);
	}

	.contact-card.highlight {
		border-color: var(--color-brand);
		background: var(--color-bg-subtle);
	}

	.contact-card h3 {
		font-size: 13px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 2.5px;
		color: var(--color-brand);
		margin-bottom: 10px;
	}

	.contact-card p {
		font-size: 14.5px;
		line-height: 1.6;
	}

	.hotline a {
		font-size: 23px;
		font-weight: 700;
		color: var(--color-brand);
	}

	.sub {
		font-size: 13.5px;
		color: var(--color-text-secondary);
		margin-top: 4px;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
		text-align: left;
	}

	.step {
		padding: 20px;
		background: var(--color-bg-subtle);
	}

	.step span {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-weight: 700;
		font-size: 14px;
		margin-bottom: 10px;
	}

	.step h4 {
		font-size: 13px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-bottom: 6px;
	}

	.step p {
		font-size: 13.5px;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.btn {
		display: inline-block;
		margin: 0 6px;
		padding: 11px 26px;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: 14px;
		border-radius: 0;
		transition: background var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-brand-hover);
		color: var(--color-on-brand);
	}

	.btn-outline {
		background: transparent;
		border: 1px solid var(--color-brand);
		color: var(--color-brand);
	}

	.btn-outline:hover {
		background: var(--color-brand);
		color: var(--color-on-brand);
	}

	@media (max-width: 800px) {
		.steps {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 540px) {
		.contact-grid,
		.steps {
			grid-template-columns: 1fr;
		}

		.page-title {
			font-size: 20px;
		}

		.section-title {
			font-size: 17px;
		}
	}
</style>
