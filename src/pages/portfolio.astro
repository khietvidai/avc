---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { enCategorySlug } from "../utils/i18n-routes";
import { marketImageSeo } from "../utils/image-seo";

const { entries: linhVucRaw, cacheHint } = await getEmDashCollection("linh_vuc", { locale: "vi" });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const linhVuc = linhVucRaw.toSorted(
	(a, b) => (a.data.sort_order ?? 0) - (b.data.sort_order ?? 0)
);

const LV_EN: Record<string, string> = {
	"nha-hang": "Restaurants",
	"khach-san": "Hotels",
	"bep-trung-tam": "Central Kitchens",
	"khu-cong-nghiep": "Industrial Canteens",
	bakery: "Bakeries",
	"bar-cafe": "Bar & Café",
};

function isBrand(i: number): boolean {
	return (Math.floor(i / 2) + (i % 2)) % 2 === 0;
}
---

<Base title="Portfolio" description="AVC commercial kitchen portfolio by market: restaurants, hotels, central kitchens, industrial canteens, bakeries, bars & cafés">
	<div class="page">
		<h1 class="page-title">PORTFOLIO</h1>
		<hr class="dashed-divider" />
		<p class="lead">1,500+ commercial kitchen projects nationwide — choose a market to explore AVC's completed work.</p>

		<div class="portfolio-grid">
			{
				linhVuc.map((lv, i) => (
					<a
						href={`/category/${enCategorySlug(lv.id)}`}
						class:list={["cell", isBrand(i) ? "cell-brand" : "cell-gray"]}
					>
						<div class="cell-label">
							<span>{LV_EN[lv.id] ?? lv.data.title}</span>
						</div>
						<div class="cell-image">
							{lv.data.image && (
								<Image
									image={lv.data.image}
									alt={marketImageSeo(lv.id).alt}
									title={marketImageSeo(lv.id).title}
								/>
							)}
						</div>
					</a>
				))
			}
		</div>
	</div>
</Base>

<style>
	.page {
		max-width: 1000px;
		margin: 0 auto;
		padding: 44px 24px 80px;
		text-align: center;
	}

	.page-title {
		font-size: 26px;
		font-weight: 700;
		letter-spacing: 2.5px;
		color: var(--color-brand);
	}

	.dashed-divider {
		width: 210px;
		margin: 16px auto 34px;
		border: none;
		border-bottom: 2px dashed var(--avc-divider);
	}

	.lead {
		max-width: 640px;
		margin: 0 auto 44px;
		font-size: 15px;
		line-height: 1.65;
	}

	.portfolio-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
	}

	.cell {
		display: grid;
		grid-template-columns: 1fr 1fr;
		height: 440px;
		overflow: hidden;
	}

	.cell-label {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		padding: 0 26px;
		text-align: left;
	}

	.cell-brand .cell-label {
		background: var(--color-brand);
	}

	.cell-gray .cell-label {
		background: #a39a96;
	}

	.cell-label span {
		color: #ffffff;
		font-size: 18px;
		font-weight: 600;
		letter-spacing: 2px;
		text-transform: uppercase;
		line-height: 1.35;
	}

	.cell-image {
		overflow: hidden;
		background: #e9e9e9;
	}

	.cell-image :global(img) {
		width: 100%;
		height: 440px;
		object-fit: cover;
		transition: transform var(--transition-base);
	}

	.cell:hover .cell-image :global(img) {
		transform: scale(1.04);
	}

	.cell-brand:hover .cell-label {
		background: var(--color-brand-hover);
	}

	.cell-gray:hover .cell-label {
		background: #948b87;
	}

	@media (max-width: 800px) {
		.portfolio-grid {
			grid-template-columns: 1fr;
		}

		.cell {
			height: 320px;
		}

		.cell-image :global(img) {
			height: 320px;
		}

		.cell-label span {
			font-size: 15px;
		}
	}

	@media (max-width: 540px) {
		.page-title {
			font-size: 20px;
		}
	}
</style>
