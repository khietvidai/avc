---
import Base from "../layouts/Base.astro";

const products = [
	{ title: "Commercial Cooking", desc: "Western & Asian ranges, fryers, griddles, char grills — Eagle, Berjaya, Lestov, Berto's." },
	{ title: "Refrigeration", desc: "Freezers, chillers, counter fridges, display chillers — Turbocool, Hoshizaki, Turbo Air." },
	{ title: "Ice Machines", desc: "Cube and flake ice machines from café to central-kitchen capacity — Hoshizaki, Scotsman." },
	{ title: "Combi Ovens", desc: "Combi and convection ovens for restaurants, hotels and bakeries — Unox, Lainox, Venix." },
	{ title: "Display Cases", desc: "Cake and food display chillers for bakeries, cafés and convenience stores." },
	{ title: "Warewashing & Prep", desc: "Commercial dishwashers, cutters, mixers and slicers — Hobart, Robot Coupe, Sirman, Fimar." },
	{ title: "Custom Stainless", desc: "Tables, sinks, shelving, cabinets, trolleys and bar counters fabricated at AVC's factory." },
	{ title: "Exhaust Systems", desc: "Hoods, ductwork, fans and air treatment for commercial kitchens — designed and installed as one." },
];

const brands = [
	"Eagle", "Turbocool", "Hoshizaki", "Unox", "Lainox", "Robot Coupe", "Hobart", "Scotsman",
	"Fimar", "Lotus", "Venix", "Lestov", "Sirman", "Berjaya", "Chanmag", "Menumaster",
	"Hatco", "ATA", "Jiwins", "Turbo Air", "Berto's",
];

const principles = [
	"Listen to and understand each client's needs",
	"Apply and continuously improve the ISO 14001:2015 quality management system",
	"Fully comply with quality regulations",
	"Follow correct procedures and keep raising product quality",
];
---

<Base title="Products & Brands" description="AVC supplies complete commercial kitchen equipment: cooking, refrigeration, warewashing, custom stainless, bar counters and exhaust systems from trusted international brands">
	<div class="page">
		<section class="section">
			<h1 class="page-title">PRODUCTS &amp; BRANDS</h1>
			<hr class="dashed-divider" />
			<p class="lead">AVC supplies complete commercial kitchen equipment — cooking, refrigeration, warewashing, custom stainless, bar counters and exhaust systems — from trusted brands, with <strong>high quality and efficient cost</strong>.</p>
			<div class="products-grid">
				{products.map((s) => (
					<div class="product-card">
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				))}
			</div>
		</section>

		<section class="section" id="thuong-hieu">
			<h2 class="section-title">DISTRIBUTED BRANDS</h2>
			<hr class="dashed-divider" />
			<div class="brands">
				{brands.map((b) => <span class="brand-chip">{b}</span>)}
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">QUALITY POLICY</h2>
			<hr class="dashed-divider" />
			<div class="quality-grid">
				<div class="quality-text">
					<p>Quality is AVC's first priority and the foundation of every commitment we make. We continuously improve our engineering, adopt new technology and raise product standards to meet the market's growing expectations.</p>
					<ul>
						{principles.map((n) => <li>{n}</li>)}
					</ul>
				</div>
				<figure><img src="/images/bep-hoan-thien-2.jpg" alt="Completed AVC commercial kitchen" loading="lazy" /></figure>
			</div>
		</section>

		<section class="section" id="nha-may">
			<h2 class="section-title">FACTORY &amp; WAREHOUSE</h2>
			<hr class="dashed-divider" />
			<div class="factory-grid">
				<figure>
					<img src="/images/nha-may.jpg" alt="AVC stainless steel factory with CNC laser cutting" loading="lazy" />
					<figcaption>Stainless steel factory — professional, standardised, with CNC laser cutting</figcaption>
				</figure>
				<figure>
					<img src="/images/kho-hang.jpg" alt="AVC warehouse" loading="lazy" />
					<figcaption>AVC warehouse — stock on hand, fast nationwide delivery</figcaption>
				</figure>
			</div>
			<p class="factory-note">In-house fabrication to drawings keeps schedules under control, ensures detail-level quality and covers each project's special fabrication needs.</p>
		</section>

		<section class="section cta-section">
			<p class="cta-text">Need an equipment quote or a turnkey solution?</p>
			<a href="/contact" class="btn">Contact AVC</a>
		</section>
	</div>
</Base>

<style>
	.page {
		max-width: 1000px;
		margin: 0 auto;
		padding: 44px 24px 80px;
	}

	.section {
		margin-bottom: 64px;
		text-align: center;
	}

	.page-title {
		font-size: 26px;
		font-weight: 700;
		letter-spacing: 2.5px;
		color: var(--color-brand);
	}

	.section-title {
		font-size: 21px;
		font-weight: 700;
		letter-spacing: 2.5px;
		color: var(--color-brand);
	}

	.dashed-divider {
		width: 210px;
		margin: 16px auto 34px;
		border: none;
		border-bottom: 2px dashed var(--avc-divider);
	}

	.lead {
		max-width: 700px;
		margin: 0 auto 40px;
		font-size: 15px;
		line-height: 1.65;
	}

	.lead strong {
		color: var(--color-brand);
		font-weight: 700;
	}

	.products-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
		text-align: left;
	}

	.product-card {
		padding: 20px;
		border: 1px solid var(--color-border);
	}

	.product-card h3 {
		font-size: 13px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: var(--color-brand);
		margin-bottom: 8px;
	}

	.product-card p {
		font-size: 13.5px;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.brands {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
	}

	.brand-chip {
		padding: 10px 22px;
		border: 1px solid var(--color-border);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	.quality-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
		align-items: center;
		text-align: left;
	}

	.quality-text p {
		font-size: 14.5px;
		line-height: 1.65;
		margin-bottom: 16px;
	}

	.quality-text ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.quality-text li {
		font-size: 14px;
		line-height: 1.5;
		padding-left: 22px;
		position: relative;
	}

	.quality-text li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--color-brand);
		font-weight: 700;
	}

	.quality-grid img {
		width: 100%;
		object-fit: cover;
	}

	.factory-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	.factory-grid img {
		width: 100%;
		height: 280px;
		object-fit: cover;
	}

	.factory-grid figcaption {
		font-size: 13px;
		color: var(--avc-footer-text);
		margin-top: 8px;
	}

	.factory-note {
		max-width: 700px;
		margin: 28px auto 0;
		font-size: 14.5px;
		line-height: 1.65;
	}

	.cta-text {
		font-size: 16px;
		margin-bottom: 20px;
	}

	.btn {
		display: inline-block;
		padding: 11px 26px;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: 14px;
		border-radius: 0;
		transition: background var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-brand-hover);
		color: var(--color-on-brand);
	}

	@media (max-width: 900px) {
		.products-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 800px) {
		.quality-grid,
		.factory-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 540px) {
		.products-grid {
			grid-template-columns: 1fr;
		}

		.page-title {
			font-size: 20px;
		}

		.section-title {
			font-size: 17px;
		}
	}
</style>
