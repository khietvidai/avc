---
import Base from "../layouts/Base.astro";

const values = [
	{ num: "01", title: "Safety", desc: "The first priority in the design, installation and operation of every commercial kitchen." },
	{ num: "02", title: "Integrity", desc: "Honest, transparent and accountable in every activity and partnership." },
	{ num: "03", title: "Quality", desc: "Products and solutions built to technical standards, durability and efficiency." },
	{ num: "04", title: "Dedication", desc: "Listening, understanding and accompanying clients throughout every project." },
	{ num: "05", title: "Commitment", desc: "Committed to schedule, quality and after-sales service as contracted." },
	{ num: "06", title: "Sincerity", desc: "Partnerships built on trust and lasting long-term relationships." },
];

const factors = [
	{ title: "Safety", desc: "Full compliance with technical standards, labour safety and current regulations." },
	{ title: "Turnkey Solutions", desc: "Consulting – design – manufacturing – installation – warranty, all in one." },
	{ title: "Technical Capability", desc: "Engineers and technicians with hands-on project experience." },
	{ title: "Manufacturing", desc: "Stainless steel fabrication to drawings with strict quality control." },
	{ title: "Project Management", desc: "Disciplined execution that protects schedule and quality." },
	{ title: "After-sales & Support", desc: "Warranty, maintenance and technical support as contracted." },
];

const clients = [
	"Pizza 4P's", "Lotte Hotels & Resorts", "Sun Group", "Golden Gate Group", "Vinpearl", "Novaland",
	"Heineken Vietnam", "Aman", "Lotteria", "Sushi Tei", "Cộng Cà Phê", "Katinat", "Vinschool",
	"TTC Hotel", "Sailing Club Nha Trang", "Quán Bụi Group", "Jumbo Seafood", "Luk Lak", "Chickita", "East West Brewing",
];

const regions = [
	{ name: "North", provinces: "Hanoi, Bac Ninh, Hai Duong, Hai Phong, Lao Cai, Nghe An, Ha Tinh" },
	{ name: "Central", provinces: "Da Nang, Lam Dong, Quang Ngai, Khanh Hoa, Hue" },
	{ name: "South", provinces: "Ho Chi Minh City, Dong Nai, Tay Ninh, Can Tho, An Giang, Ca Mau, Vinh Long" },
];
---

<Base title="About" description="About AVC Industrial Equipment Co., Ltd — 15+ years of experience, 1,500+ commercial kitchen projects across Vietnam">
	<div class="page">
		<section class="section">
			<h1 class="page-title">ABOUT AVC</h1>
			<hr class="dashed-divider" />
			<div class="intro-grid">
				<div class="intro-text">
					<p>AVC was founded with a clear focus: putting <strong>quality and safety first</strong> in every commercial kitchen solution. We continuously refine our products, services and construction processes to deliver kitchen systems that are efficient, durable and optimised for real operations.</p>
					<p>With experience across F&amp;B, restaurant &amp; hotel, central kitchen and industrial projects nationwide, AVC delivers <strong>solutions that fit real operational needs</strong> — effective and sustainable for every project.</p>
					<p>Our experienced engineers and technicians, together with a <strong>fully integrated value chain</strong> — consulting, design, manufacturing, installation, after-sales — are the foundation of every project's quality.</p>
				</div>
				<figure class="intro-photo">
					<img src="/images/team-avc.jpg" alt="AVC team" loading="lazy" />
					<figcaption>The AVC team — Stress-Free Kitchen</figcaption>
				</figure>
			</div>
		</section>

		<section class="section mission">
			<div class="mission-grid">
				<div class="mission-card">
					<h3>Mission</h3>
					<p>Create kitchen solutions that are safe, efficient and sustainable — elevating the operating experience and helping clients reach international standards.</p>
				</div>
				<div class="mission-card dark">
					<h3>Vision</h3>
					<p>To lead Vietnam in the design, manufacturing and installation of international-standard commercial kitchen solutions — efficient, safe and sustainable.</p>
				</div>
			</div>
		</section>

		<section class="section" id="gia-tri">
			<h2 class="section-title">CORE VALUES</h2>
			<hr class="dashed-divider" />
			<div class="values-grid">
				{values.map((v) => (
					<div class="value-card">
						<span class="value-num">{v.num}</span>
						<h3>{v.title}</h3>
						<p>{v.desc}</p>
					</div>
				))}
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">WHAT SETS US APART</h2>
			<hr class="dashed-divider" />
			<div class="factors-grid">
				{factors.map((y) => (
					<div class="factor-card">
						<h4>{y.title}</h4>
						<p>{y.desc}</p>
					</div>
				))}
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">PROJECT FOOTPRINT</h2>
			<hr class="dashed-divider" />
			<div class="regions-grid">
				{regions.map((v) => (
					<div class="region-card">
						<h4>{v.name}</h4>
						<p>{v.provinces}</p>
					</div>
				))}
			</div>
			<div class="stats-row">
				<div class="stat"><strong>15+</strong><span>Years of experience</span></div>
				<div class="stat"><strong>1,500+</strong><span>Completed projects</span></div>
				<div class="stat"><strong>24/7</strong><span>Support &amp; maintenance</span></div>
			</div>
		</section>

		<section class="section" id="doi-ngu">
			<h2 class="section-title">TEAM &amp; CULTURE</h2>
			<hr class="dashed-divider" />
			<div class="culture-grid">
				<figure><img src="/images/khen-thuong.jpg" alt="AVC team recognition" loading="lazy" /></figure>
				<div class="culture-text">
					<p>AVC's strongest competitive advantage is its people — passionate, resilient and always striving to make a difference: people who dare to think and act, embrace change, and reach for higher standards in every project.</p>
					<p>We believe people are the foundation of every success, and we invest continuously in training and development — from technical skills and new technology to a spirit of service.</p>
					<p>AVC also participates actively in F&amp;B industry exhibitions such as <strong>Food &amp; Hospitality Vietnam</strong>, keeping our clients up to date with the latest kitchen technology and trends.</p>
				</div>
			</div>
		</section>

		<section class="section">
			<h2 class="section-title" id="khach-hang">SELECTED CLIENTS</h2>
			<hr class="dashed-divider" />
			<div class="clients">
				{clients.map((k) => <span class="client-chip">{k}</span>)}
			</div>
		</section>

		<section class="section cta-section">
			<a href="/portfolio" class="btn">View our portfolio</a>
		</section>
	</div>
</Base>

<style>
	.page {
		max-width: 1000px;
		margin: 0 auto;
		padding: 44px 24px 80px;
	}

	.section {
		margin-bottom: 64px;
		text-align: center;
	}

	.page-title {
		font-size: 26px;
		font-weight: 700;
		letter-spacing: 2.5px;
		color: var(--color-brand);
	}

	.section-title {
		font-size: 21px;
		font-weight: 700;
		letter-spacing: 2.5px;
		color: var(--color-brand);
	}

	.dashed-divider {
		width: 210px;
		margin: 16px auto 34px;
		border: none;
		border-bottom: 2px dashed var(--avc-divider);
	}

	.intro-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
		align-items: center;
		text-align: left;
	}

	.intro-text {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.intro-text p {
		font-size: 15px;
		line-height: 1.65;
	}

	.intro-text strong,
	.culture-text strong {
		color: var(--color-brand);
		font-weight: 700;
	}

	.intro-photo img {
		width: 100%;
		object-fit: cover;
	}

	.intro-photo figcaption {
		font-size: 13px;
		color: var(--avc-footer-text);
		margin-top: 8px;
		text-align: center;
	}

	.mission-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
		text-align: left;
	}

	.mission-card {
		padding: 32px 28px;
		background: var(--color-bg-subtle);
		border-top: 3px solid var(--color-brand);
	}

	.mission-card.dark {
		background: #2b3440;
		color: #e8e8e8;
	}

	.mission-card h3 {
		font-size: 16px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-brand);
		margin-bottom: 12px;
	}

	.mission-card p {
		font-size: 14.5px;
		line-height: 1.65;
	}

	.values-grid,
	.factors-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		text-align: left;
	}

	.value-card {
		padding: 24px;
		border: 1px solid var(--color-border);
	}

	.value-num {
		display: inline-block;
		font-size: 18px;
		font-weight: 700;
		color: var(--color-brand);
		margin-bottom: 8px;
	}

	.value-card h3 {
		font-size: 15px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-bottom: 8px;
	}

	.value-card p,
	.factor-card p {
		font-size: 14px;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.factor-card {
		padding: 20px;
		background: var(--color-bg-subtle);
	}

	.factor-card h4 {
		font-size: 14px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: var(--color-brand);
		margin-bottom: 6px;
	}

	.regions-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}

	.region-card {
		padding: 20px;
		border: 1px solid var(--color-border);
	}

	.region-card h4 {
		display: inline-block;
		background: #2b3440;
		color: #fff;
		font-size: 13px;
		letter-spacing: 1px;
		padding: 4px 14px;
		margin-bottom: 10px;
	}

	.region-card p {
		font-size: 13.5px;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.stats-row {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin-top: 32px;
	}

	.stat strong {
		display: block;
		font-size: 27px;
		font-weight: 700;
		color: var(--color-brand);
	}

	.stat span {
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		color: var(--color-text-secondary);
	}

	.culture-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
		align-items: center;
		text-align: left;
	}

	.culture-grid img {
		width: 100%;
		object-fit: cover;
	}

	.culture-text {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.culture-text p {
		font-size: 14.5px;
		line-height: 1.65;
	}

	.clients {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
	}

	.client-chip {
		padding: 8px 18px;
		border: 1px solid var(--color-border);
		font-size: 13px;
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.btn {
		display: inline-block;
		padding: 11px 26px;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: 14px;
		border-radius: 0;
		transition: background var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-brand-hover);
		color: var(--color-on-brand);
	}

	@media (max-width: 800px) {
		.intro-grid,
		.mission-grid,
		.culture-grid {
			grid-template-columns: 1fr;
		}

		.values-grid,
		.factors-grid,
		.regions-grid,
		.stats-row {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 540px) {
		.values-grid,
		.factors-grid,
		.regions-grid,
		.stats-row {
			grid-template-columns: 1fr;
		}

		.page-title {
			font-size: 20px;
		}

		.section-title {
			font-size: 17px;
		}
	}
</style>
