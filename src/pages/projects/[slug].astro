---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { publicOrigin } from "../../utils/site-url";
import { cmsProjectSlug, enProjectSlug, enCategorySlug } from "../../utils/i18n-routes";
import { projectEn } from "../../utils/projects-en";
import { projectImageSeo } from "../../utils/image-seo";

const param = decodeSlug(Astro.params.slug);

if (!param) {
	return Astro.redirect("/404");
}

const cmsSlug = cmsProjectSlug(param);
const enSlug = enProjectSlug(cmsSlug);
if (param !== enSlug) {
	return Astro.redirect(`/projects/${enSlug}`, 301);
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", cmsSlug, {
	locale: "vi",
});

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: publicOrigin(Astro.url),
	path: `/projects/${enSlug}`,
	defaultOgImage: featuredImageUrl,
});

const galleryRaw = Array.isArray(post.data.gallery) ? post.data.gallery : [];
const images = [post.data.featured_image, ...galleryRaw].filter(Boolean);

const LV_EN: Record<string, string> = {
	"nha-hang": "Restaurants",
	"khach-san": "Hotels",
	"bep-trung-tam": "Central Kitchens",
	"khu-cong-nghiep": "Industrial Canteens",
	bakery: "Bakeries",
	"bar-cafe": "Bar & Café",
};
const categories = post.data.terms?.category ?? [];

const { entries: recentPosts } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 4,
	locale: "vi",
});
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);
const en = projectEn(cmsSlug);
const title = en?.title ?? post.data.title;
const client = (en?.client ?? post.data.chu_dau_tu)?.trim() || "";
const location = (en?.location ?? post.data.dia_chi)?.trim() || "";
const body = en?.body;
const year = post.data.nam_hoan_thanh?.trim() || "";
const scaleRaw = post.data.quy_mo?.trim() || "";
const scale =
	scaleRaw === "Bảo mật" || scaleRaw.toLowerCase() === "confidential"
		? "Confidential"
		: scaleRaw;
const showInfo = !!(year || scale || client || location);
---

<Base
	title={en ? `${en.title} — ${siteTitle}` : seo.title}
	pageTitle={en?.title ?? seo.ogTitle}
	description={en?.excerpt ?? seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug: cmsSlug }}
	project={{
		name: title,
		description: en?.excerpt ?? post.data.excerpt,
		image: featuredImageUrl,
		url: seo.canonical ?? "",
		location,
		client,
		datePublished: post.data.publishedAt?.toISOString() ?? null,
		dateModified: post.data.updatedAt.toISOString(),
	}}
>
	<article class="project">
		{
			images.length > 0 && (
				<div class="gallery-viewer">
					<div class="gallery-track" id="gallery-track">
						{images.map((img, i) => (
							<div class="gallery-frame" data-index={i}>
								<Image
									image={img}
									alt={projectImageSeo(cmsSlug, i === 0 ? "featured" : "gallery").alt}
									title={projectImageSeo(cmsSlug, i === 0 ? "featured" : "gallery").title}
								/>
							</div>
						))}
					</div>
					{images.length > 1 && (
						<div class="gallery-thumbs">
							{images.map((img, i) => (
								<button
									class:list={["thumb", { active: i === 0 }]}
									data-index={i}
									aria-label={`Photo ${i + 1} — ${title}`}
								>
									<Image
										image={img}
										alt={projectImageSeo(cmsSlug, i === 0 ? "featured" : "gallery").alt}
										title={projectImageSeo(cmsSlug, i === 0 ? "featured" : "gallery").title}
									/>
								</button>
							))}
						</div>
					)}
				</div>
			)
		}

		<div class="project-body">
			<h1 class="project-title">{title}</h1>
			<hr class="dashed-divider" />
			{
				(location || categories.length > 0) && (
					<p class="project-sub">
						{categories.length > 0 && (
							<a href={`/category/${enCategorySlug(categories[0].slug)}`}>
								{LV_EN[categories[0].slug] ?? categories[0].label}
							</a>
						)}
						{categories.length > 0 && location && " | "}
						{location}
					</p>
				)
			}

			{
				showInfo && (
					<div class="project-info">
						{(year || scale) && (
							<div class="info-col">
								{year && (
									<div class="info-block">
										<h2>Completed</h2>
										<p>{year}</p>
									</div>
								)}
								{scale && (
									<div class="info-block">
										<h2>Scale</h2>
										<p>{scale}</p>
									</div>
								)}
							</div>
						)}
						{(client || location) && (
							<div class="info-col">
								{client && (
									<div class="info-block">
										<h2>Client</h2>
										<p>{client}</p>
									</div>
								)}
								{location && (
									<div class="info-block">
										<h2>Location</h2>
										<p>{location}</p>
									</div>
								)}
							</div>
						)}
					</div>
				)
			}

			<div class="project-content">
				{
					body ? (
						body.map((p) => <p>{p}</p>)
					) : (
						<PortableText value={post.data.content} />
					)
				}
			</div>
		</div>
	</article>

	{
		otherPosts.length > 0 && (
			<section class="more-projects">
				<div class="more-inner">
					<h2 class="more-title">More projects</h2>
					<div class="more-grid">
						{otherPosts.map((p) => (
							<a href={`/projects/${enProjectSlug(p.id)}`} class="more-item">
								{p.data.featured_image && (
									<div class="more-image">
										<Image
											image={p.data.featured_image}
											alt={projectImageSeo(p.id, "featured").alt}
											title={projectImageSeo(p.id, "featured").title}
										/>
									</div>
								)}
								<span class="more-label">{projectEn(p.id)?.title ?? p.data.title}</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	<script>
		const track = document.getElementById("gallery-track");
		const thumbs = [...document.querySelectorAll<HTMLElement>(".thumb")];
		if (track && thumbs.length) {
			thumbs.forEach((t) =>
				t.addEventListener("click", () => {
					const i = Number(t.dataset.index);
					const frame = track.querySelector<HTMLElement>(
						`.gallery-frame[data-index="${i}"]`
					);
					frame?.scrollIntoView({
						behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
							? "auto"
							: "smooth",
						inline: "center",
						block: "nearest",
					});
					thumbs.forEach((x) => x.classList.toggle("active", x === t));
				})
			);
		}
	</script>
</Base>

<style>
	.gallery-viewer {
		width: 100%;
	}

	.gallery-track {
		display: flex;
		gap: 6px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
	}

	.gallery-frame {
		flex: 0 0 33.7%;
		scroll-snap-align: center;
		height: 460px;
		background: #e9e9e9;
	}

	.gallery-frame :global(img) {
		width: 100%;
		height: 460px;
		object-fit: cover;
	}

	.gallery-thumbs {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 8px;
		padding: 14px 24px 0;
	}

	.thumb {
		width: 76px;
		height: 54px;
		padding: 0;
		border: 2px solid transparent;
		background: #e9e9e9;
		cursor: pointer;
		overflow: hidden;
	}

	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumb.active,
	.thumb:hover {
		border-color: var(--color-brand);
	}

	.project-body {
		max-width: 860px;
		margin: 0 auto;
		padding: 52px 24px 64px;
		text-align: center;
	}

	.project-title {
		font-size: 25px;
		font-weight: 500;
		letter-spacing: 2.5px;
		text-transform: uppercase;
		color: #6b6560;
	}

	.dashed-divider {
		width: 320px;
		max-width: 80%;
		margin: 16px auto;
		border: none;
		border-bottom: 1.5px dashed var(--avc-divider);
	}

	.project-sub {
		font-size: 14.5px;
		color: var(--color-brand);
		margin-bottom: 40px;
	}

	.project-sub a {
		color: var(--color-brand);
		text-decoration: none;
	}

	.project-sub a:hover {
		text-decoration: underline;
	}

	.project-info {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 0;
		max-width: 640px;
		margin: 0 auto 48px;
		text-align: left;
	}

	.info-col {
		padding: 0 32px;
	}

	.info-col + .info-col {
		border-left: 1px dashed var(--avc-divider);
	}

	.info-col:only-child {
		border: none;
	}

	.info-block {
		margin-bottom: 22px;
	}

	.info-block h2 {
		font-size: 12.5px;
		font-weight: 700;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: #6b6560;
		margin-bottom: 4px;
	}

	.info-block p {
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	.project-content {
		text-align: left;
		font-size: 14.5px;
		line-height: 1.75;
		color: var(--color-text-secondary);
	}

	.project-content :global(p) {
		margin-bottom: 1.4em;
	}

	.project-content :global(strong) {
		color: var(--color-brand);
	}

	.more-projects {
		background: var(--color-bg-subtle);
		padding: 56px 0 64px;
	}

	.more-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 24px;
	}

	.more-title {
		font-size: 19px;
		font-weight: 700;
		letter-spacing: 1px;
		color: var(--color-brand);
		margin-bottom: 28px;
	}

	.more-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}

	.more-item {
		display: block;
	}

	.more-image {
		height: 220px;
		overflow: hidden;
		background: #e9e9e9;
	}

	.more-image :global(img) {
		width: 100%;
		height: 220px;
		object-fit: cover;
		transition: transform var(--transition-base);
	}

	.more-item:hover .more-image :global(img) {
		transform: scale(1.04);
	}

	.more-label {
		display: block;
		padding: 12px 2px;
		font-size: 14.5px;
		font-weight: 500;
		color: var(--color-text);
	}

	.more-item:hover .more-label {
		color: var(--color-brand);
	}

	@media (max-width: 900px) {
		.gallery-frame,
		.gallery-frame :global(img) {
			height: 320px;
		}

		.gallery-frame {
			flex-basis: 60%;
		}

		.more-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 600px) {
		.project-title {
			font-size: 18px;
		}

		.project-info {
			grid-template-columns: 1fr;
		}

		.info-col + .info-col {
			border-left: none;
			border-top: 1px dashed var(--avc-divider);
			padding-top: 20px;
		}

		.gallery-frame {
			flex-basis: 88%;
		}
	}
</style>
