---
import Base from "../layouts/Base.astro";
import NotFound from "../components/NotFound.astro";

const isVI =
	Astro.currentLocale === "vi" ||
	Astro.url.pathname.startsWith("/vi") ||
	Astro.url.searchParams.get("lang") === "vi";
---

<Base
	title={isVI ? "Không tìm thấy trang" : "Page not found"}
	description={isVI ? "Trang này không tồn tại trên website AVC." : "This page does not exist on the AVC website."}
	robots="noindex, nofollow"
>
	<NotFound locale={isVI ? "vi" : "en"} />
</Base>
