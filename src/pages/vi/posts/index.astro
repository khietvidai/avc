---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../../layouts/Base.astro";
import { projectImageSeo } from "../../../utils/image-seo";
import { viProjectPath } from "../../../utils/i18n-routes";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	locale: "vi",
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const withImage = posts.filter((p) => p.data.featured_image);
---

<Base title="Dự án" description="Các công trình bếp công nghiệp AVC đã triển khai trên toàn quốc">
	<div class="page">
		<h1 class="page-title">DỰ ÁN ĐÃ TRIỂN KHAI</h1>
		<hr class="dashed-divider" />
		<p class="lead">{withImage.length} công trình — chọn một dự án để xem chi tiết.</p>

		{
			withImage.length === 0 ? (
				<p class="empty">Chưa có dự án nào.</p>
			) : (
				<div class="gallery">
					{withImage.map(({ id, data }) => (
						<a href={viProjectPath(id)} class="gallery-item">
							<Image
								image={data.featured_image}
								alt={projectImageSeo(id, "featured").alt}
								title={projectImageSeo(id, "featured").title}
							/>
							<span class="gallery-overlay">
								<span>{data.title}</span>
							</span>
						</a>
					))}
				</div>
			)
		}
	</div>
</Base>

<style>
	.page {
		max-width: 1000px;
		margin: 0 auto;
		padding: 52px 24px 80px;
		text-align: center;
	}

	.page-title {
		font-size: 25px;
		font-weight: 700;
		letter-spacing: 3px;
		text-transform: uppercase;
		color: var(--color-brand);
	}

	.dashed-divider {
		width: 210px;
		margin: 16px auto 24px;
		border: none;
		border-bottom: 2px dashed var(--avc-divider);
	}

	.lead {
		max-width: 640px;
		margin: 0 auto 40px;
		font-size: 15px;
		line-height: 1.65;
		color: var(--color-text);
	}

	.empty {
		color: var(--color-text-secondary);
		font-size: 14.5px;
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}

	.gallery-item {
		position: relative;
		display: block;
		height: 280px;
		overflow: hidden;
		background: #e9e9e9;
	}

	.gallery-item :global(img) {
		width: 100%;
		height: 280px;
		object-fit: cover;
		transition: transform var(--transition-base);
	}

	.gallery-item:hover :global(img) {
		transform: scale(1.04);
	}

	.gallery-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 20px;
		background: rgba(255, 255, 255, 0.72);
		opacity: 0;
		transition: opacity var(--transition-base);
	}

	.gallery-item:hover .gallery-overlay {
		opacity: 1;
	}

	.gallery-overlay span {
		font-size: 15px;
		font-weight: 500;
		line-height: 1.35;
		color: #4a4440;
		text-align: center;
	}

	@media (max-width: 800px) {
		.gallery {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 540px) {
		.gallery {
			grid-template-columns: 1fr;
		}

		.page-title {
			font-size: 19px;
		}
	}
</style>
