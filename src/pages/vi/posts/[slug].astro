---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../../utils/site-identity";
import { publicOrigin } from "../../../utils/site-url";
import { projectImageSeo } from "../../../utils/image-seo";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug, { locale: "vi" });

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Get featured image URL for OG fallback
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: publicOrigin(Astro.url),
	path: `/vi/posts/${slug}`,
	defaultOgImage: featuredImageUrl,
});

// Gallery: ảnh đại diện + thư viện ảnh phụ
const galleryRaw = Array.isArray(post.data.gallery) ? post.data.gallery : [];
const images = [post.data.featured_image, ...galleryRaw].filter(Boolean);

// Danh mục của dự án (đã hydrate trên entry)
const categories = post.data.terms?.category ?? [];

// Dự án khác
const { entries: recentPosts } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 4,
	locale: "vi",
});
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
	project={{
		name: post.data.title,
		description: post.data.excerpt,
		image: featuredImageUrl,
		url: seo.canonical ?? "",
		location: post.data.dia_chi,
		client: post.data.chu_dau_tu,
		datePublished: post.data.publishedAt?.toISOString() ?? null,
		dateModified: post.data.updatedAt.toISOString(),
	}}
>
	<article class="project">
		{/* Gallery: hàng ảnh lớn kéo ngang + thumbnails */}
		{
			images.length > 0 && (
				<div class="gallery-viewer">
					<div class="gallery-track" id="gallery-track">
						{images.map((img, i) => (
							<div class="gallery-frame" data-index={i}>
								<Image image={img} alt={projectImageSeo(slug, i === 0 ? "featured" : "gallery").alt} title={projectImageSeo(slug, i === 0 ? "featured" : "gallery").title} />
							</div>
						))}
					</div>
					{images.length > 1 && (
						<div class="gallery-thumbs">
							{images.map((img, i) => (
								<button
									class:list={["thumb", { active: i === 0 }]}
									data-index={i}
									aria-label={`Ảnh ${i + 1}`}
								>
									<Image image={img} alt={projectImageSeo(slug, i === 0 ? "featured" : "gallery").alt} title={projectImageSeo(slug, i === 0 ? "featured" : "gallery").title} />
								</button>
							))}
						</div>
					)}
				</div>
			)
		}

		<div class="project-body">
			<h1 class="project-title" {...post.edit.title}>{post.data.title}</h1>
			<hr class="dashed-divider" />
			{
				(post.data.dia_chi || categories.length > 0) && (
					<p class="project-sub">
						{categories.length > 0 && (
							<a href={`/vi/category/${categories[0].slug}`}>
								{categories[0].label}
							</a>
						)}
						{categories.length > 0 && post.data.dia_chi && " | "}
						{post.data.dia_chi}
					</p>
				)
			}

			<div class="project-info">
				<div class="info-col">
					<div class="info-block">
						<h2>Năm hoàn thành</h2>
						<p {...post.edit.nam_hoan_thanh}>
							{post.data.nam_hoan_thanh || "Đang cập nhật"}
						</p>
					</div>
					<div class="info-block">
						<h2>Quy mô</h2>
						<p {...post.edit.quy_mo}>{post.data.quy_mo || "Bảo mật"}</p>
					</div>
				</div>
				<div class="info-col">
					<div class="info-block">
						<h2>Chủ đầu tư</h2>
						<p {...post.edit.chu_dau_tu}>
							{post.data.chu_dau_tu || "Đang cập nhật"}
						</p>
					</div>
					<div class="info-block">
						<h2>Địa chỉ</h2>
						<p {...post.edit.dia_chi}>
							{post.data.dia_chi || "Đang cập nhật"}
						</p>
					</div>
				</div>
			</div>

			<div class="project-content">
				<PortableText value={post.data.content} />
			</div>
		</div>
	</article>

	{
		otherPosts.length > 0 && (
			<section class="more-projects">
				<div class="more-inner">
					<h2 class="more-title">Dự án khác</h2>
					<div class="more-grid">
						{otherPosts.map((p) => (
							<a href={`/vi/posts/${p.id}`} class="more-item">
								{p.data.featured_image && (
									<div class="more-image">
										<Image image={p.data.featured_image} alt={projectImageSeo(p.id, "featured").alt} title={projectImageSeo(p.id, "featured").title} />
									</div>
								)}
								<span class="more-label">{p.data.title}</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	<script>
		// Thumbnail click -> cuộn ảnh tương ứng vào hàng lớn
		const track = document.getElementById("gallery-track");
		const thumbs = [...document.querySelectorAll<HTMLElement>(".thumb")];
		if (track && thumbs.length) {
			thumbs.forEach((t) =>
				t.addEventListener("click", () => {
					const i = Number(t.dataset.index);
					const frame = track.querySelector<HTMLElement>(
						`.gallery-frame[data-index="${i}"]`
					);
					frame?.scrollIntoView({
						behavior: "smooth",
						inline: "center",
						block: "nearest",
					});
					thumbs.forEach((x) => x.classList.toggle("active", x === t));
				})
			);
		}
	</script>
</Base>

<style>
	/* Gallery */
	.gallery-viewer {
		width: 100%;
	}

	.gallery-track {
		display: flex;
		gap: 6px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
	}

	.gallery-frame {
		flex: 0 0 33.7%;
		scroll-snap-align: center;
		height: 460px;
		background: #e9e9e9;
	}

	.gallery-frame :global(img) {
		width: 100%;
		height: 460px;
		object-fit: cover;
	}

	.gallery-thumbs {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 8px;
		padding: 14px 24px 0;
	}

	.thumb {
		width: 76px;
		height: 54px;
		padding: 0;
		border: 2px solid transparent;
		background: #e9e9e9;
		cursor: pointer;
		overflow: hidden;
	}

	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumb.active,
	.thumb:hover {
		border-color: var(--color-brand);
	}

	/* Nội dung */
	.project-body {
		max-width: 860px;
		margin: 0 auto;
		padding: 52px 24px 64px;
		text-align: center;
	}

	.project-title {
		font-size: 25px;
		font-weight: 500;
		letter-spacing: 2.5px;
		text-transform: uppercase;
		color: #6b6560;
	}

	.dashed-divider {
		width: 320px;
		max-width: 80%;
		margin: 16px auto;
		border: none;
		border-bottom: 1.5px dashed var(--avc-divider);
	}

	.project-sub {
		font-size: 14.5px;
		color: var(--color-brand);
		margin-bottom: 40px;
	}

	.project-sub a {
		color: var(--color-brand);
		text-decoration: none;
	}

	.project-sub a:hover {
		text-decoration: underline;
	}

	.project-info {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
		max-width: 640px;
		margin: 0 auto 48px;
		text-align: left;
	}

	.info-col {
		padding: 0 32px;
	}

	.info-col + .info-col {
		border-left: 1px dashed var(--avc-divider);
	}

	.info-block {
		margin-bottom: 22px;
	}

	.info-block h2 {
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		color: #6b6560;
		margin-bottom: 4px;
	}

	.info-block p {
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	.project-content {
		text-align: left;
		font-size: 14.5px;
		line-height: 1.75;
		color: var(--color-text-secondary);
	}

	.project-content :global(p) {
		margin-bottom: 1.4em;
	}

	.project-content :global(strong) {
		color: var(--color-brand);
	}

	/* Dự án khác */
	.more-projects {
		background: var(--color-bg-subtle);
		padding: 56px 0 64px;
	}

	.more-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 24px;
	}

	.more-title {
		font-size: 19px;
		font-weight: 700;
		color: var(--color-brand);
		margin-bottom: 28px;
	}

	.more-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}

	.more-item {
		display: block;
	}

	.more-image {
		height: 220px;
		overflow: hidden;
		background: #e9e9e9;
	}

	.more-image :global(img) {
		width: 100%;
		height: 220px;
		object-fit: cover;
		transition: transform var(--transition-base);
	}

	.more-item:hover .more-image :global(img) {
		transform: scale(1.04);
	}

	.more-label {
		display: block;
		padding: 12px 2px;
		font-size: 14.5px;
		font-weight: 500;
		color: var(--color-text);
	}

	.more-item:hover .more-label {
		color: var(--color-brand);
	}

	@media (max-width: 900px) {
		.gallery-frame,
		.gallery-frame :global(img) {
			height: 320px;
		}

		.gallery-frame {
			flex-basis: 60%;
		}

		.more-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 600px) {
		.project-title {
			font-size: 19px;
		}

		.project-info {
			grid-template-columns: 1fr;
		}

		.info-col + .info-col {
			border-left: none;
			border-top: 1px dashed var(--avc-divider);
			padding-top: 20px;
		}

		.gallery-frame {
			flex-basis: 88%;
		}
	}
</style>
