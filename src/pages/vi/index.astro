---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const [{ entry: home, cacheHint: homeHint }, settings] = await Promise.all([
	getEmDashEntry("home", "home", { locale: "vi" }),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(homeHint);

const { entries: linhVucRaw, cacheHint: linhVucHint } =
	await getEmDashCollection("linh_vuc", { locale: "vi" });
if (Astro.cache?.enabled) Astro.cache.set(linhVucHint);

// Sort in JS: sort_order is a custom field, keep the query simple
const linhVuc = linhVucRaw.toSorted(
	(a, b) => (a.data.sort_order ?? 0) - (b.data.sort_order ?? 0)
);

const stats = home
	? [
			home.data.stat_1,
			home.data.stat_2,
			home.data.stat_3,
			home.data.stat_4,
		].filter(Boolean)
	: [];
---

<Base
	title={siteTitle}
	description={siteTagline}
	content={home
		? { collection: "home", id: home.data.id, slug: home.id }
		: undefined}
>
	{
		!home ? (
			<section class="empty-state">
				<h2>Chưa có nội dung trang chủ</h2>
				<p>
					Tạo entry <strong>Trang chủ</strong> (slug <code>home</code>) trong
					trang quản trị để hiển thị nội dung.
				</p>
				<a href="/_emdash/admin" class="btn">
					Mở trang quản trị
				</a>
			</section>
		) : (
			<div class="home">
				{/* Hero */}
				<section class="hero" id="top">
					{home.data.hero_image && (
						<div class="hero-image" {...home.edit.hero_image}>
							<Image image={home.data.hero_image} />
						</div>
					)}
					<span class="hero-arrow hero-arrow-left" aria-hidden="true">
						‹
					</span>
					<span class="hero-arrow hero-arrow-right" aria-hidden="true">
						›
					</span>
				</section>

				{/* Stats strip */}
				{stats.length > 0 && (
					<section class="stats">
						<p>
							{stats.map((stat, i) => (
								<>
									{i > 0 && <span class="stats-sep"> | </span>}
									<span>{stat}</span>
								</>
							))}
						</p>
					</section>
				)}

				{/* Giới thiệu */}
				<section class="gioi-thieu" id="gioi-thieu">
					{home.data.intro_heading && (
						<h1 {...home.edit.intro_heading}>{home.data.intro_heading}</h1>
					)}
					<hr class="dashed-divider" />
					{home.data.intro && (
						<div class="intro" {...home.edit.intro}>
							<PortableText value={home.data.intro} />
						</div>
					)}
					{home.data.cta_label && (
						<a href={home.data.cta_url || "/vi/#linh-vuc"} class="btn">
							{home.data.cta_label}
						</a>
					)}
				</section>

				{/* Lĩnh vực */}
				<section class="linh-vuc" id="linh-vuc">
					{home.data.services_heading && (
						<h2 {...home.edit.services_heading}>
							{home.data.services_heading}
						</h2>
					)}
					<hr class="dashed-divider" />
					{home.data.services_intro && (
						<div class="linh-vuc-intro" {...home.edit.services_intro}>
							<PortableText value={home.data.services_intro} />
						</div>
					)}
					{linhVuc.length > 0 && (
						<div class="linh-vuc-grid">
							{linhVuc.map((lv) => (
								<a class="linh-vuc-card" href={`/vi/category/${lv.id}`}>
									<div class="linh-vuc-image" {...lv.edit.image}>
										{lv.data.image && <Image image={lv.data.image} />}
									</div>
									<div class="linh-vuc-label" {...lv.edit.title}>
										{lv.data.title}
									</div>
								</a>
							))}
						</div>
					)}
				</section>
			</div>
		)
	}
</Base>

<style>
	/* Hero */
	.hero {
		position: relative;
		width: 100%;
		height: 440px;
		background: #e9e9e9;
		overflow: hidden;
	}

	.hero-image,
	.hero-image :global(img) {
		width: 100%;
		height: 440px;
		object-fit: cover;
	}

	.hero-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		font-size: 44px;
		font-weight: 300;
		color: rgba(255, 255, 255, 0.7);
		pointer-events: none;
		line-height: 1;
	}

	.hero-arrow-left {
		left: 24px;
	}

	.hero-arrow-right {
		right: 24px;
	}

	/* Stats strip */
	.stats {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 26px 24px 0;
		text-align: center;
	}

	.stats p {
		font-size: 14px;
		font-weight: 700;
		color: var(--avc-stats-text);
	}

	/* Shared */
	.dashed-divider {
		width: 210px;
		margin: 16px auto 34px;
		border: none;
		border-bottom: 2px dashed var(--avc-divider);
	}

	.btn {
		display: inline-block;
		margin-top: 36px;
		padding: 11px 26px;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: 14px;
		border-radius: 0;
		transition: background var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-brand-hover);
		color: var(--color-on-brand);
	}

	/* Giới thiệu */
	.gioi-thieu {
		max-width: 900px;
		margin: 0 auto;
		padding: 44px 24px 24px;
		text-align: center;
	}

	.gioi-thieu h1 {
		font-size: 26px;
		font-weight: 700;
		letter-spacing: 2.5px;
		color: var(--color-brand);
		text-wrap: balance;
	}

	.intro {
		text-align: left;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.intro :global(p) {
		font-size: 15px;
		line-height: 1.65;
		color: var(--color-text);
	}

	.intro :global(strong) {
		color: var(--color-brand);
		font-weight: 700;
	}

	/* Lĩnh vực */
	.linh-vuc {
		max-width: 1000px;
		margin: 0 auto;
		padding: 56px 24px 80px;
		text-align: center;
	}

	.linh-vuc h2 {
		font-size: 23px;
		font-weight: 700;
		letter-spacing: 2.5px;
		color: var(--color-brand);
	}

	.linh-vuc-intro {
		text-align: left;
		max-width: 700px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.linh-vuc-intro :global(p) {
		font-size: 15px;
		line-height: 1.65;
		color: var(--color-text);
	}

	.linh-vuc-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		margin-top: 48px;
	}

	.linh-vuc-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.linh-vuc-card:hover .linh-vuc-label {
		background: var(--color-brand-hover);
	}

	.linh-vuc-card:hover .linh-vuc-image :global(img) {
		transform: scale(1.03);
	}

	.linh-vuc-image :global(img) {
		transition: transform var(--transition-base);
	}

	.linh-vuc-image {
		width: 100%;
		height: 250px;
		background: #e9e9e9;
		overflow: hidden;
	}

	.linh-vuc-image :global(img) {
		width: 100%;
		height: 250px;
		object-fit: cover;
	}

	.linh-vuc-label {
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: 16px;
		font-weight: 700;
		padding: 12px 8px;
	}

	/* Empty state */
	.empty-state {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-24) var(--spacing-6);
		text-align: center;
	}

	.empty-state h2 {
		margin-bottom: var(--spacing-4);
	}

	.empty-state p {
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-6);
	}

	@media (max-width: 900px) {
		.linh-vuc-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.hero,
		.hero-image,
		.hero-image :global(img) {
			height: 320px;
		}
	}

	@media (max-width: 600px) {
		.linh-vuc-grid {
			grid-template-columns: 1fr;
		}

		.gioi-thieu h1 {
			font-size: 21px;
		}

		.linh-vuc h2 {
			font-size: 19px;
		}

		.stats-sep {
			display: block;
			height: 0;
			overflow: hidden;
		}
	}
</style>
