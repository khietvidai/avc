---
import Base from "../../layouts/Base.astro";

const services = [
	{
		id: "tu-van",
		title: "Tư vấn đầu tư",
		banner: "/images/banner-tu-van.jpg",
		desc: "AVC đồng hành cùng chủ đầu tư ngay từ giai đoạn đầu tư: đánh giá công suất, tiêu chuẩn dự án và ngân sách dựa trên nhu cầu vận hành thực tế. Kinh nghiệm 1.500+ công trình giúp chúng tôi đề xuất phương án thiết bị phù hợp từng mô hình — từ nhà hàng độc lập đến bếp trung tâm và căn tin khu công nghiệp.",
		items: [
			"Tư vấn giai đoạn đầu tư", "Đánh giá công suất dự án",
			"Tiêu chuẩn kỹ thuật dự án", "Hoạch định ngân sách",
			"Khảo sát mặt bằng thực tế", "Phân tích yêu cầu vận hành",
			"Đề xuất phương án thiết bị", "Tối ưu chi phí đầu tư & vận hành",
		],
	},
	{
		id: "thiet-ke",
		title: "Thiết kế bếp công nghiệp",
		banner: "/images/banner-thiet-ke.jpg",
		desc: "Mỗi dự án được dựng mặt bằng 2D, mô hình 3D và bố trí hệ thống MEP (điện – nước – thông gió) trước khi sản xuất, giúp chủ đầu tư hình dung chính xác không gian bếp và loại bỏ rủi ro khi thi công. Thiết kế theo quy trình một chiều — tiếp nhận, sơ chế, chế biến, chia suất, rửa — đảm bảo an toàn vệ sinh thực phẩm và tối ưu nhân lực.",
		items: [
			"Kiểm tra & đo đạc mặt bằng", "Phân tích quy trình làm việc",
			"Thiết kế mặt bằng 2D", "Thiết kế mô hình 3D",
			"Bố trí hệ thống MEP", "Quy trình bếp một chiều",
			"Phối hợp kiến trúc sư & nhà thầu", "Hồ sơ kỹ thuật thi công",
		],
	},
	{
		id: "cung-cap",
		title: "Cung cấp thiết bị",
		banner: "/images/banner-cung-cap.jpg",
		desc: "AVC phân phối thiết bị từ 21 thương hiệu quốc tế uy tín — Hoshizaki, Unox, Hobart, Robot Coupe, Turbocool, Eagle… — kết hợp thiết bị inox sản xuất theo bản vẽ tại nhà máy riêng. Kho hàng tại TP.HCM đảm bảo hàng hoá có sẵn, giao nhanh tận nơi trên toàn quốc.",
		items: [
			"Thiết bị nhập khẩu chính hãng", "Thiết bị inox sản xuất theo bản vẽ",
			"21 thương hiệu quốc tế", "Hàng hoá có sẵn tại kho",
			"Giao hàng nhanh toàn quốc", "Lắp đặt & hướng dẫn vận hành",
			"Bảo hành chính hãng", "Chi phí hiệu quả",
		],
	},
	{
		id: "thi-cong",
		title: "Thi công lắp đặt",
		banner: "/images/banner-thi-cong.jpg",
		desc: "Thi công và lắp đặt thiết bị theo bản vẽ kỹ thuật đã phê duyệt, phối hợp đồng bộ các hạng mục với nhà thầu xây dựng. AVC ứng dụng quy trình kiểm soát rủi ro toàn diện và phương pháp thi công chuẩn quốc tế — đặc biệt với các hạng mục độ khó cao như hệ thống hút khói và kho lạnh.",
		items: [
			"Thi công hệ thống bếp", "Thi công hệ thống hút khói",
			"Thi công quầy bar inox", "Thi công kho đông – kho mát",
			"Phối hợp đồng bộ hạng mục", "An toàn lao động đa lớp",
			"Kiểm tra vận hành thiết bị", "Nghiệm thu & bàn giao",
		],
	},
	{
		id: "bao-hanh",
		title: "Bảo hành – Bảo trì",
		banner: "/images/banner-bao-hanh.jpg",
		desc: "Sau bàn giao, AVC tiếp tục đồng hành trong suốt vòng đời dự án: bảo hành thiết bị theo cam kết hợp đồng, tiếp nhận và xử lý sự cố kỹ thuật kịp thời, bảo trì định kỳ để hệ thống bếp vận hành ổn định, an toàn và hiệu quả — với đội kỹ thuật hỗ trợ 24/7.",
		items: [
			"Bảo hành theo hợp đồng", "Xử lý sự cố kịp thời",
			"Hướng dẫn vận hành thiết bị", "Bảo trì định kỳ",
			"Kiểm tra & đánh giá tình trạng", "Linh kiện thay thế chính hãng",
			"Hỗ trợ kỹ thuật 24/7", "Hợp đồng bảo trì dài hạn",
		],
	},
	{
		id: "san-xuat",
		title: "Sản xuất inox",
		banner: "/images/banner-san-xuat.jpg",
		desc: "Nhà máy sản xuất inox của AVC với máy cắt laser CNC hiện đại gia công thiết bị theo bản vẽ từng công trình: bàn, chậu, kệ, tủ, xe đẩy, quầy bar, chụp hút khói và ống gió. Năng lực sản xuất riêng giúp AVC chủ động tiến độ và kiểm soát chất lượng từng chi tiết.",
		items: [
			"Máy cắt laser CNC", "Gia công theo bản vẽ riêng",
			"Bàn – chậu – kệ – tủ inox", "Quầy bar chế tạo theo thiết kế",
			"Chụp hút khói & ống gió", "Xe đẩy & thiết bị đặc thù",
			"Kiểm soát chất lượng từng chi tiết", "Chủ động tiến độ sản xuất",
		],
	},
];
---

<Base title="Dịch vụ" description="Giải pháp bếp công nghiệp trọn gói của AVC: tư vấn đầu tư, thiết kế 2D/3D & MEP, cung cấp thiết bị, thi công lắp đặt, bảo hành bảo trì và sản xuất inox">
	<div class="page">
		<header class="page-header">
			<h1 class="page-title">DỊCH VỤ</h1>
			<hr class="dashed-divider" />
			<p class="lead">Chuỗi giá trị khép kín <strong>tư vấn – thiết kế – sản xuất – thi công – hậu mãi</strong> giúp AVC kiểm soát chất lượng xuyên suốt và tối ưu chi phí đầu tư cho từng công trình bếp công nghiệp.</p>
		</header>

		{services.map((s, i) => (
			<section class="service" id={s.id}>
				<div class="service-banner">
					<img src={s.banner} alt={s.title} width="1400" height="450" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} decoding="async" />
				</div>
				<h2 class="service-title">{s.title}</h2>
				<p class="service-desc">{s.desc}</p>
				<ul class="service-items">
					{s.items.map((item) => <li>{item}</li>)}
				</ul>
			</section>
		))}

		<section class="cta-section">
			<p class="cta-text">Cần tư vấn giải pháp bếp cho công trình của bạn?</p>
			<a href="/vi/lien-he" class="btn">Liên hệ AVC</a>
			<a href="/vi/posts" class="btn btn-outline">Xem dự án đã triển khai</a>
		</section>
	</div>
</Base>

<style>
	.page {
		max-width: 1000px;
		margin: 0 auto;
		padding: 44px 24px 80px;
	}

	.page-header {
		text-align: center;
		margin-bottom: 56px;
	}

	.page-title {
		font-size: 26px;
		font-weight: 700;
		letter-spacing: 2.5px;
		color: var(--color-brand);
	}

	.dashed-divider {
		width: 210px;
		margin: 16px auto 34px;
		border: none;
		border-bottom: 2px dashed var(--avc-divider);
	}

	.lead {
		max-width: 700px;
		margin: 0 auto;
		font-size: 15px;
		line-height: 1.65;
	}

	.lead strong {
		color: var(--color-brand);
		font-weight: 700;
	}

	/* Section dịch vụ theo mẫu: banner → tiêu đề → mô tả → cột bullet */
	.service {
		margin-bottom: 72px;
		text-align: center;
		scroll-margin-top: 24px;
	}

	.service-banner {
		height: 280px;
		overflow: hidden;
		background: #e9e9e9;
		margin-bottom: 28px;
	}

	.service-banner img {
		width: 100%;
		height: 280px;
		object-fit: cover;
	}

	.service-title {
		font-size: 21px;
		font-weight: 700;
		letter-spacing: 0.5px;
		color: var(--color-brand);
		margin-bottom: 18px;
	}

	.service-desc {
		max-width: 780px;
		margin: 0 auto 26px;
		font-size: 14.5px;
		line-height: 1.7;
		text-align: center;
	}

	.service-items {
		list-style: none;
		max-width: 720px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px 48px;
		text-align: left;
	}

	.service-items li {
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-text-secondary);
		padding-left: 20px;
		position: relative;
	}

	.service-items li::before {
		content: "•";
		position: absolute;
		left: 4px;
		color: var(--color-brand);
		font-weight: 700;
	}

	.cta-section {
		text-align: center;
		margin-top: 8px;
	}

	.cta-text {
		font-size: 16px;
		margin-bottom: 20px;
	}

	.btn {
		display: inline-block;
		margin: 0 6px;
		padding: 11px 26px;
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: 14px;
		border-radius: 0;
		transition: background var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-brand-hover);
		color: var(--color-on-brand);
	}

	.btn-outline {
		background: transparent;
		border: 1px solid var(--color-brand);
		color: var(--color-brand);
	}

	.btn-outline:hover {
		background: var(--color-brand);
		color: var(--color-on-brand);
	}

	@media (max-width: 640px) {
		.page-title {
			font-size: 21px;
		}

		.service-title {
			font-size: 18px;
		}

		.service-banner,
		.service-banner img {
			height: 180px;
		}

		.service-items {
			grid-template-columns: 1fr;
		}
	}
</style>
