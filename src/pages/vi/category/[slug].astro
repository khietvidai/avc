---
import { getTerm, getEmDashCollection, decodeSlug } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../../layouts/Base.astro";
import { resolveSlide } from "../../../utils/slide-image";
import { projectImageSeo } from "../../../utils/image-seo";
import { bareCmsId, viProjectPath } from "../../../utils/i18n-routes";

const raw = decodeSlug(Astro.params.slug);
const slug = raw ? bareCmsId(raw) : "";
if (raw && slug && raw !== slug) {
	return Astro.redirect(`/vi/category/${slug}`, 301);
}
const term = slug ? await getTerm("category", slug, { locale: "vi" }) : null;

if (!term) {
	return Astro.rewrite("/vi/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { category: bareCmsId(term.slug) },
	orderBy: { published_at: "desc" },
	locale: "vi",
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const withImage = posts.filter((p) => p.data.featured_image);
const slides = withImage.slice(0, 6).map((p) => ({
	post: p,
	slide: resolveSlide(p.id, p.data.slide_image, p.data.featured_image),
}));
---

<Base
	title={`${term.label} — Portfolio`}
	description={`Các dự án bếp công nghiệp AVC đã triển khai trong lĩnh vực ${term.label}`}
>
	{
		slides.length > 0 && (
			<div class="slider" role="region" aria-label={`Dự án tiêu biểu ${term.label}`}>
				{slides.map(({ post: p, slide }, i) => (
					<a
						href={viProjectPath(p.id)}
						class:list={["slide", { active: i === 0 }]}
						data-index={i}
					>
						{
							slide?.kind === "static" ? (
								<img
									src={slide.src}
									alt={projectImageSeo(p.id, "slide").alt}
									title={projectImageSeo(p.id, "slide").title}
									width="1920"
									height="1080"
									loading={i === 0 ? "eager" : "lazy"}
									fetchpriority={i === 0 ? "high" : undefined}
									decoding="async"
								/>
							) : slide ? (
								<Image image={slide.image} alt={projectImageSeo(p.id, "slide").alt} title={projectImageSeo(p.id, "slide").title} width={1920} height={1080} priority={i === 0} />
							) : null
						}
						<span class="slide-caption">{p.data.title}</span>
					</a>
				))}
				{slides.length > 1 && (
					<>
						<button class="slider-arrow slider-prev" aria-label="Dự án trước">‹</button>
						<button class="slider-arrow slider-next" aria-label="Dự án sau">›</button>
						<div class="slider-dots">
							{slides.map((_, i) => (
								<button
									class:list={["dot", { active: i === 0 }]}
									data-index={i}
									aria-label={`Slide ${i + 1}`}
								></button>
							))}
						</div>
					</>
				)}
			</div>
		)
	}

	<div class="page">
		<h1 class="page-title">{term.label}</h1>
		<hr class="dashed-divider" />

		{
			posts.length === 0 ? (
				<p class="empty">
					Chưa có dự án trong lĩnh vực này — các công trình mới sẽ được cập
					nhật sớm. <a href="/vi/posts">Xem tất cả dự án</a>
				</p>
			) : (
				<div class="gallery">
					{withImage.map(({ id, data }) => (
						<a href={viProjectPath(id)} class="gallery-item">
							<Image image={data.featured_image} alt={projectImageSeo(id, "featured").alt} title={projectImageSeo(id, "featured").title} />
							<span class="gallery-overlay">
								<span>{data.title}</span>
							</span>
						</a>
					))}
				</div>
			)
		}
	</div>

	<script>
	// Slider: tự chạy + mũi tên + chấm điều hướng
	const slider = document.querySelector(".slider");
	if (slider) {
		const slides = [...slider.querySelectorAll<HTMLElement>(".slide")];
		const dots = [...slider.querySelectorAll<HTMLElement>(".dot")];
		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		function show(i: number) {
			current = (i + slides.length) % slides.length;
			slides.forEach((s, j) => s.classList.toggle("active", j === current));
			dots.forEach((d, j) => d.classList.toggle("active", j === current));
		}

		function restart() {
			if (timer) clearInterval(timer);
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (slides.length > 1 && !reduce) {
				timer = setInterval(() => show(current + 1), 5000);
			}
		}

		slider.querySelector(".slider-prev")?.addEventListener("click", (e) => {
			e.preventDefault();
			show(current - 1);
			restart();
		});
		slider.querySelector(".slider-next")?.addEventListener("click", (e) => {
			e.preventDefault();
			show(current + 1);
			restart();
		});
		dots.forEach((d) =>
			d.addEventListener("click", (e) => {
				e.preventDefault();
				show(Number(d.dataset.index));
				restart();
			})
		);
		restart();
	}
	</script>
</Base>

<style>
	/* Slider full-width */
	.slider {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		max-height: 560px;
		background: #e9e9e9;
		overflow: hidden;
	}

	.slide {
		position: absolute;
		inset: 0;
		display: block;
		opacity: 0;
		transition: opacity 0.6s ease;
		pointer-events: none;
	}

	.slide.active {
		opacity: 1;
		pointer-events: auto;
	}

	.slide :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.slide-caption {
		position: absolute;
		left: 0;
		bottom: 56px;
		padding: 12px 26px;
		background: rgba(74, 68, 64, 0.78);
		color: #ffffff;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
	}

	.slider-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		background: none;
		border: none;
		color: rgba(255, 255, 255, 0.85);
		font-size: 52px;
		font-weight: 300;
		line-height: 1;
		cursor: pointer;
		padding: 8px 14px;
		z-index: 5;
		transition: color var(--transition-fast);
	}

	.slider-arrow:hover {
		color: #ffffff;
	}

	.slider-prev {
		left: 14px;
	}

	.slider-next {
		right: 14px;
	}

	.slider-dots {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		bottom: 22px;
		display: flex;
		gap: 10px;
		z-index: 5;
	}

	.dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		border: none;
		background: rgba(255, 255, 255, 0.55);
		cursor: pointer;
		padding: 0;
	}

	.dot.active {
		background: #ffffff;
	}

	/* Nội dung */
	.page {
		max-width: 1000px;
		margin: 0 auto;
		padding: 52px 24px 80px;
		text-align: center;
	}

	.page-title {
		font-size: 25px;
		font-weight: 700;
		letter-spacing: 3px;
		text-transform: uppercase;
		color: var(--color-brand);
	}

	.dashed-divider {
		width: 210px;
		margin: 16px auto 40px;
		border: none;
		border-bottom: 2px dashed var(--avc-divider);
	}

	.empty {
		color: var(--color-text-secondary);
		font-size: 14.5px;
	}

	/* Lưới ảnh 3 cột, hover hiện tên dự án */
	.gallery {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}

	.gallery-item {
		position: relative;
		display: block;
		height: 280px;
		overflow: hidden;
		background: #e9e9e9;
	}

	.gallery-item :global(img) {
		width: 100%;
		height: 280px;
		object-fit: cover;
		transition: transform var(--transition-base);
	}

	.gallery-item:hover :global(img) {
		transform: scale(1.04);
	}

	.gallery-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 20px;
		background: rgba(255, 255, 255, 0.72);
		opacity: 0;
		transition: opacity var(--transition-base);
	}

	.gallery-item:hover .gallery-overlay {
		opacity: 1;
	}

	.gallery-overlay span {
		font-size: 16px;
		font-weight: 500;
		line-height: 1.35;
		color: #4a4440;
		text-align: center;
	}

	@media (max-width: 800px) {
		.slider {
			max-height: 320px;
		}

		.gallery {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 540px) {
		.gallery {
			grid-template-columns: 1fr;
		}

		.page-title {
			font-size: 19px;
		}

		.slide-caption {
			font-size: 14px;
			bottom: 44px;
		}
	}
</style>
